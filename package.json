{
  "name": "tentacle",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:create": "node-pg-migrate create --migration-file-language sql",
    "migrate:up": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "seed": "tsx src/db/seed.ts",
    "docs:openapi": "shx mkdir -p docs/temp && p2o tentacle.postman_collection.json -f docs/temp/openapi.yaml",
    "docs:build": "npm run docs:openapi && shx cp docs/docs-template.html docs/temp/index.html",
    "docs": "npm run docs:build && live-server docs/temp --open=index.html",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "check": "npm run typecheck && biome check .",
    "check:fix": "biome check . --write",
    "typecheck-and-lint": "npm run typecheck && biome ci .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpcoutinho/tentacle.git"
  },
  "keywords": [],
  "author": "Filipe Coutinho <fpcoutinho5@gmail.com>",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/fpcoutinho/tentacle/issues"
  },
  "homepage": "https://github.com/fpcoutinho/tentacle#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "live-server": "^1.2.2",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "postman-to-openapi": "^3.0.1",
    "shx": "^0.4.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "jose": "^5.10.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
