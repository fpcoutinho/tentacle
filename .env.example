NODE_ENV=development
PORT=3000

# standalone (container/local, com app.listen) ou serverless (function por invocacao)
RUNTIME_MODE=standalone

DATABASE_URL=postgres://postgres:postgres@localhost:5432/tentacle

# false usa o dummy auth (header x-dev-user-id) em vez do Firebase - mais facil pra rodar localmente
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# origens permitidas para CORS, separadas por virgula
CORS_ORIGIN=http://localhost:5173